{
  "mcpServers": {
    "neuramd": {
      "command": "bin/mcp-server",
      "args": []
    },
    "neuramd-gateway": {
      "type": "http",
      "url": "http://AIrch.local:3000/mcp",
      "headers": {
        "Authorization": "Bearer REPLACE_WITH_GATEWAY_TOKEN"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl=http://127.0.0.1:9222"
      ]
    }
  }
}
